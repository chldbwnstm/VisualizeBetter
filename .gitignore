# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.hypothesis/

# uv
# uv.lock is committed intentionally (reproducible installs)

# Node / frontend
node_modules/
frontend/dist/

# PyInstaller sidecar build artifacts — the exe is produced in CI, not committed
/build/
/dist/

# Snapshots (SQLite) — local runtime data
*.sqlite
*.sqlite3
*.db

# clone_smoketest.py run artifacts (reports/baselines, not source)
scripts/_baselines/

# Server discovery file — written by `serve` and contains the auth token in
# plain text. Running with `--data-dir .` puts it inside the checkout, where an
# untracked, unignored file gets swept up by `git add -A`.
serve.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Playwright
frontend/test-results/
frontend/playwright-report/

# Internal design document — not part of the published tree
VISUALIZEBETTER_PROJECT_PLAN.txt

# Internal working notes — not part of the published tree
reports/
CLAUDE.md
PROGRESS.md
