{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "VisualizeBetter",
  "version": "0.1.0",
  "identifier": "app.visualizebetter.desktop",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VisualizeBetter",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/visualizebetter"],
    "resources": [],
    "category": "DeveloperTool",
    "shortDescription": "MCP-native realtime graph workspace",
    "longDescription": "VisualizeBetter desktop shell ([8-F]): the same React SPA the web app uses, with `visualizebetter serve` bundled as a sidecar so the app runs with no Python install and no browser."
  },
  "plugins": {}
}
